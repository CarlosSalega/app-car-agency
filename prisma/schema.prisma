generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum CarType {
  SUV
  SEDAN
  HATCHBACK
  PICKUP
  COUPE
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum FuelType {
  GASOLINE
  DIESEL
  CNG
  HYBRID
  ELECTRIC
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum Currency {
  ARS
  USD
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(COLLABORATOR)
  isActive       Boolean   @default(true)
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  cars          Car[]      @relation("UserCars")
  logs          Log[]
  payments      Payment[]
  createdBrands Brand[]    @relation("UserBrands")
  createdModels Model[]    @relation("UserModels")
  createdTags   Tag[]      @relation("UserTags")
  createdLocations Location[] @relation("UserLocations")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id])
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Brand {
  id     String  @id @default(uuid())
  name   String  @unique
  models Model[]
  cars   Car[]
  createdById String
  createdBy   User   @relation("UserBrands", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id      String @id @default(uuid())
  name    String
  brand   Brand  @relation(fields: [brandId], references: [id])
  brandId String
  cars    Car[]
  createdById String
  createdBy   User   @relation("UserModels", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([name, brandId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("UserTags", fields: [createdById], references: [id])
  cars        Car[] 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          String   @id @default(uuid())
  name        String   @unique  
  address     String   
  city        String
  state       String
  zipCode     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  latitude    Float?
  longitude   Float?
  createdById String
  createdBy   User   @relation("UserLocations", fields: [createdById], references: [id])
  cars        Car[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Car {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  brandId      String
  brand        Brand         @relation(fields: [brandId], references: [id])
  modelId      String
  model        Model         @relation(fields: [modelId], references: [id])
  version      String?
  color        String?
  year         Int
  kilometers   Int
  type         CarType
  fuelType     FuelType
  transmission Transmission?
  patent       String?       @unique
  price        Float
  currency     Currency      @default(ARS)
  description  String
  locationId   String?
  location     Location?     @relation(fields: [locationId], references: [id])
  images       String[]
  tags         Tag[]
  status       CarStatus     @default(AVAILABLE)
  soldAt       DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String?
  user         User?         @relation("UserCars", fields: [userId], references: [id])
  payments     Payment[]
  visits       Visit[]

  // ========================================
  // 🆕 FINANCIACIÓN
  // ========================================
  acceptsFinancing     Boolean   @default(false)
  financingMinDeposit  Int?      // Porcentaje de anticipo mínimo (0-100)
  financingMaxMonths   Int?      // Plazo máximo en meses (12, 24, 36, 48, 60)
  financingRate        Float?    // TNA% personalizada (opcional, si null usa la global)
  financingNotes       String?   @db.Text // Condiciones adicionales del vendedor

  // ========================================
  // 🆕 PERMUTA
  // ========================================
  acceptsTrade         Boolean   @default(false)
  tradeNotes           String?   @db.Text // Condiciones de permuta

  // ========================================
  // 🆕 MÉTODOS DE PAGO
  // ========================================
  acceptsCash          Boolean   @default(true)
  acceptsTransfer      Boolean   @default(true)
  acceptsCrypto        Boolean   @default(false)

  // ========================================
  // 🆕 ESTADÍSTICAS (para dashboard vendedor)
  // ========================================
  viewCount            Int       @default(0) // Contador de vistas
  contactCount         Int       @default(0) // Clicks en WhatsApp/teléfono
  favoriteCount        Int       @default(0) // Veces agregado a favoritos

  @@index([userId])
  @@index([status])
  @@index([brandId])
  @@index([modelId])
  @@index([acceptsFinancing])
  @@index([acceptsTrade])
}

model Payment {
  id             String         @id @default(uuid())
  amount         Float
  currency       Currency       @default(ARS)
  method         PaymentMethod
  status         PaymentStatus  @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  carId String
  car   Car    @relation(fields: [carId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  statusHistory PaymentStatusHistory[]
}

model PaymentStatusHistory {
  id          String        @id @default(uuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id])
  oldStatus   PaymentStatus?
  newStatus   PaymentStatus
  changedAt   DateTime      @default(now())
  changedBy   String?       
  notes       String?       
}

model Log {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?  
  createdAt DateTime @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
}

model Settings {
  id                String   @id @default(uuid())
  key               String   @unique
  value             String
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}